#!/usr/bin/env python3
"""Kuna adapter (see adapters/README.md). Needs KUNA_BIN.

Batch: `kuna decompile-project <bin> --addr A ... --define-function @F -o DIR` writes
DIR/index.jsonl ({name, addr, size, error, c_offset, c_len}) and the C text in
DIR/*.c; each function is the slice [c_offset, c_offset + c_len). A function the
batch did not produce is retried alone with `kuna decompile <bin> <addr> --addr
--json`. If Kuna reports addresses at a load base, the constant offset that maps
the most of them onto the requested addresses is used.

List mode (--list-functions): `kuna functions <bin> --json`, Kuna's whole-binary
inventory ({name, address, address_hex, aliases, object_location, size} per
entry, engine addresses = ELF virtual addresses). `size` is Kuna's own extent: an
upper bound clipped at the next entry or the end of the code section, so
alignment padding is counted in. An entry with size 0 is, per Kuna, one in no
CODE section (an import pointer slot, an undefined external) or one whose extent
could not be measured: it is left out unless its start lies in an executable
PT_LOAD segment, where it is listed with end null.
"""
import argparse
import collections
import glob
import json
import os
import struct
import subprocess
import sys
import tempfile

ap = argparse.ArgumentParser()
ap.add_argument("--list-functions", action="store_true")
for k in ("binary", "addresses", "elf_base", "out"):
    ap.add_argument("--" + k.replace("_", "-"), required=k != "addresses")
a = ap.parse_args()
kuna = os.environ["KUNA_BIN"]


def exec_segments(path):
    """[lo, hi) of every executable PT_LOAD segment of an ELF file."""
    with open(path, "rb") as f:
        data = f.read()
    if data[:4] != b"\x7fELF":
        return []
    is64, e = data[4] == 2, "<" if data[5] == 1 else ">"
    if is64:
        (phoff,), (phentsize, phnum) = struct.unpack_from(e + "Q", data, 0x20), struct.unpack_from(e + "HH", data, 0x36)
    else:
        (phoff,), (phentsize, phnum) = struct.unpack_from(e + "I", data, 0x1C), struct.unpack_from(e + "HH", data, 0x2A)
    out = []
    for i in range(phnum):
        o = phoff + i * phentsize
        if is64:
            p_type, p_flags, _off, vaddr, _pa, _fsz, memsz = struct.unpack_from(e + "IIQQQQQ", data, o)
        else:
            p_type, _off, vaddr, _pa, _fsz, memsz, p_flags = struct.unpack_from(e + "IIIIIII", data, o)
        if p_type == 1 and p_flags & 1:  # PT_LOAD, PF_X
            out.append((vaddr, vaddr + memsz))
    return out


def list_functions():
    p = subprocess.run([kuna, "functions", a.binary, "--json"], capture_output=True, text=True)
    try:
        doc = json.loads(p.stdout)
        entries = doc["functions"]
    except Exception:  # noqa: BLE001
        sys.stderr.write(f"kuna functions exited {p.returncode}: {p.stderr[-500:]}\n")
        return 1
    if doc.get("error"):
        # Kuna exits 1 when it discovered no body, after writing the document
        sys.stderr.write(f"kuna: {doc['error']}\n")
    try:
        segs = exec_segments(a.binary)
    except Exception:  # noqa: BLE001
        segs = []
    found = {}
    for e in entries:
        start = int(e["address"])
        size = int(e.get("size") or 0)
        if size:
            found[start] = max(found.get(start) or 0, start + size)
        elif any(lo <= start < hi for lo, hi in segs):
            found.setdefault(start, None)
    with open(a.out, "w") as out:
        for start, end in sorted(found.items()):
            out.write(json.dumps({"start": f"{start:#x}", "end": None if end is None else f"{end:#x}"}) + "\n")
    return 0


if a.list_functions:
    sys.exit(list_functions())
if a.addresses is None:
    ap.error("--addresses is required without --list-functions")
reqs = [l.strip() for l in open(a.addresses) if l.strip()]
want = {int(r, 16) & ~1: r for r in reqs}


def best_delta(entries, targets):
    if not entries or not targets:
        return 0
    exact = sum(e in targets for e in entries)
    votes = collections.Counter(t - e for e in sorted(entries)[:300] for t in sorted(targets)[:300])
    best, hits = 0, exact
    for d, _ in votes.most_common(5):
        h = sum(e + d in targets for e in entries)
        if h > hits:
            best, hits = d, h
    return best


got, errs, note = {}, {}, ""
with tempfile.TemporaryDirectory() as td:
    o = os.path.join(td, "proj")
    # the same function starts every tool is given (Thumb bit cleared; --isa auto)
    df = os.path.join(td, "starts.txt")
    with open(df, "w") as f:
        f.write("".join(f"{va:#x}\n" for va in sorted(want)))
    cmd = [kuna, "decompile-project", a.binary, "-o", o, "--define-function", "@" + df]
    for va in sorted(want):
        cmd += ["--addr", f"{va:#x}"]
    p = subprocess.run(cmd, capture_output=True, text=True)
    idx = os.path.join(o, "index.jsonl")
    if os.path.exists(idx):
        cfiles = sorted(glob.glob(os.path.join(o, "*.c")))
        ctext = open(cfiles[0], "rb").read() if len(cfiles) == 1 else None
        entries = {}
        for line in open(idx):
            if not line.strip():
                continue
            e = json.loads(line)
            addr = int(str(e["addr"]), 16) if isinstance(e["addr"], str) else int(e["addr"])
            entries[addr & ~1] = e
        delta = best_delta(list(entries), set(want))
        for va in want:
            e = entries.get(va - delta)
            if e is None:
                continue
            if e.get("error"):
                errs[va] = str(e["error"])[:300]
            elif ctext is not None and e.get("c_len"):
                got[va] = ctext[e["c_offset"]:e["c_offset"] + e["c_len"]].decode("utf-8", "replace")
    else:
        note = f" (decompile-project exited {p.returncode}: {p.stderr[-300:]})"
with open(a.out, "w") as out:
    for va, r in sorted(want.items()):
        code, err = got.get(va), errs.get(va)
        if code is None and err is None:
            q = subprocess.run([kuna, "decompile", a.binary, f"{va:#x}", "--addr", "--json",
                                "--define-function", f"{va:#x}"], capture_output=True, text=True)
            try:
                d = json.loads(q.stdout)
                code = d.get("code") or d.get("c") or (d.get("functions") or [{}])[0].get("code")
                if not code:
                    err = "kuna: no code in --json output" + note
            except Exception:  # noqa: BLE001
                err = f"kuna decompile exited {q.returncode}: {q.stderr[-300:]}{note}"
        out.write(json.dumps({"address": r, "code": code, "error": err}) + "\n")
