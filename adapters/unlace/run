#!/usr/bin/env python3
"""Unlace adapter (see adapters/README.md). Needs UNLACE_BIN; UNLACE_SPECS when
the binary carries no built-in SLEIGH tree.

Address mode: `unlace decompile-all <bin> --json --define-function @F --addr A ...`
loads and analyzes the binary once and returns
{functions: [{address, code, error, ...}]}. A requested function the document
does not hold is retried alone with `unlace decompile <bin> <addr> --addr --json`.

List mode (--list-functions): `unlace functions <bin> --json`, the whole-binary
inventory ({name, address, size} per entry; `size` reaches the next entry or the
end of the code section, padding included). An entry with size 0 is listed only
when its start lies in an executable PT_LOAD segment, with end null.
"""
import argparse
import json
import os
import struct
import subprocess
import sys
import tempfile

ap = argparse.ArgumentParser()
ap.add_argument("--list-functions", action="store_true")
for k in ("binary", "addresses", "elf_base", "out"):
    ap.add_argument("--" + k.replace("_", "-"), required=k != "addresses")
a = ap.parse_args()
unlace = os.environ["UNLACE_BIN"]


def exec_segments(path):
    """[lo, hi) of every executable PT_LOAD segment of an ELF file."""
    with open(path, "rb") as f:
        data = f.read()
    if data[:4] != b"\x7fELF":
        return []
    is64, e = data[4] == 2, "<" if data[5] == 1 else ">"
    if is64:
        (phoff,), (phentsize, phnum) = struct.unpack_from(e + "Q", data, 0x20), struct.unpack_from(e + "HH", data, 0x36)
    else:
        (phoff,), (phentsize, phnum) = struct.unpack_from(e + "I", data, 0x1C), struct.unpack_from(e + "HH", data, 0x2A)
    out = []
    for i in range(phnum):
        o = phoff + i * phentsize
        if is64:
            p_type, p_flags, _off, vaddr, _pa, _fsz, memsz = struct.unpack_from(e + "IIQQQQQ", data, o)
        else:
            p_type, _off, vaddr, _pa, _fsz, memsz, p_flags = struct.unpack_from(e + "IIIIIII", data, o)
        if p_type == 1 and p_flags & 1:  # PT_LOAD, PF_X
            out.append((vaddr, vaddr + memsz))
    return out


def list_functions():
    p = subprocess.run([unlace, "functions", a.binary, "--json"], capture_output=True, text=True)
    try:
        entries = json.loads(p.stdout)["functions"]
    except Exception:  # noqa: BLE001
        sys.stderr.write(f"unlace functions exited {p.returncode}: {p.stderr[-500:]}\n")
        return 1
    try:
        segs = exec_segments(a.binary)
    except Exception:  # noqa: BLE001
        segs = []
    found = {}
    for e in entries:
        start, size = int(e["address"]), int(e.get("size") or 0)
        if size:
            found[start] = max(found.get(start) or 0, start + size)
        elif any(lo <= start < hi for lo, hi in segs):
            found.setdefault(start, None)
    with open(a.out, "w") as out:
        for start, end in sorted(found.items()):
            out.write(json.dumps({"start": f"{start:#x}", "end": None if end is None else f"{end:#x}"}) + "\n")
    return 0


def records(doc):
    """address (Thumb bit cleared) -> (code, error) from a decompile-all document."""
    got = {}
    for f in doc.get("functions") or []:
        try:
            addr = int(f["address"]) & ~1
        except Exception:  # noqa: BLE001
            continue
        code = f.get("code")
        got[addr] = (code if code and code.strip() else None, f.get("error"))
    return got


if a.list_functions:
    sys.exit(list_functions())
if a.addresses is None:
    ap.error("--addresses is required without --list-functions")
reqs = [l.strip() for l in open(a.addresses) if l.strip()]
want = {int(r, 16) & ~1: r for r in reqs}

got, note = {}, ""
with tempfile.TemporaryDirectory() as td:
    # the same function starts every tool is given (Thumb bit cleared)
    df = os.path.join(td, "starts.txt")
    with open(df, "w") as f:
        f.write("".join(f"{va:#x}\n" for va in sorted(want)))
    cmd = [unlace, "decompile-all", a.binary, "--json", "--define-function", "@" + df]
    for va in sorted(want):
        cmd += ["--addr", f"{va:#x}"]
    p = subprocess.run(cmd, capture_output=True, text=True)
    try:
        got = records(json.loads(p.stdout))
    except Exception:  # noqa: BLE001
        note = f" (decompile-all exited {p.returncode}: {p.stderr[-300:]})"
with open(a.out, "w") as out:
    for va, r in sorted(want.items()):
        code, err = got.get(va, (None, None))
        if code is None and err is None:
            q = subprocess.run([unlace, "decompile", a.binary, f"{va:#x}", "--addr", "--json",
                                "--define-function", f"{va:#x}"], capture_output=True, text=True)
            try:
                code, err = records(json.loads(q.stdout)).get(va, (None, None))
                if code is None and err is None:
                    err = "unlace: no record for the address" + note
            except Exception:  # noqa: BLE001
                err = f"unlace decompile exited {q.returncode}: {q.stderr[-300:]}{note}"
        out.write(json.dumps({"address": r, "code": code, "error": None if code else (str(err)[:500] if err else "no code")}) + "\n")
