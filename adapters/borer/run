#!/usr/bin/env python3
"""borer adapter (see adapters/README.md). Needs BORER_BIN.

`borer export <bin> --c out.c --library --records` once; each function is
written as `// <name> @ 0x<entry>[: status]`, a prototype, `{`, body, `}`.
`--records` writes out.records.jsonl beside it (borer's docs/records.md): per
definition, the lines borer printed from one basic block with that block's
instruction starts, and the variables with their parameter position and home
(register, or a stack slot from the CFA). These become `line_mappings` and
`variables`. Lines are block-granular: a line carries every instruction of
the block it was printed from, and a line no single block spells (braces,
loop and `if` tests, declarations) has no mapping. The records are used only
when their header's size and FNV-1a hash match out.c. No return type is
recorded. Functions the export cut for its block budget are decompiled alone
with `borer decompile <bin> <addr> full 0 <budget>`, whose text carries the
prototype in a `// signature:` comment and has no records. If borer reports
entries at a load base, the constant offset that maps the most entries onto
requested addresses is used.

List mode (--list-functions): `borer functions <bin> "" <offset> 300`, paged,
is borer's own function table (import thunks and exception funclets left out by
borer itself); each row is `entry size blocks instrs callers callees src name`,
where `size` is the code bytes the blocks hold, not the span. The end is read
from `borer function <bin> <entry>`, whose `range: <start>..<end>` line gives
the end of the highest decoded instruction (exclusive); null when that call
fails. Entries are ELF virtual addresses (borer maps ELF sections at sh_addr).
"""
import argparse
import collections
import concurrent.futures
import json
import os
import re
import subprocess
import sys
import tempfile

HEADER = re.compile(r"^// (\S+) @ (0x[0-9a-fA-F]+)(?::\s*(.*))?$")
ENV = {**os.environ, "BORER_NO_UPDATE_CHECK": "1"}
HOME_KIND = {"register": "register", "frame": "stack"}


def fnv1a64(data):
    h = 0xcbf29ce484222325
    for b in data:
        h = ((h ^ b) * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF
    return h


def read_records(c, path):
    """Per entry: (line_mappings, variables) as borer recorded them. Empty when
    the file is missing, unreadable or describes another C file."""
    if not os.path.exists(path) or not os.path.exists(c):
        return {}
    try:
        return parse_records(c, path)
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
        sys.stderr.write(f"borer: records file not read ({e!r}), not used\n")
        return {}


def parse_records(c, path):
    with open(path) as f:
        rows = [json.loads(l) for l in f if l.strip()]
    data = open(c, "rb").read()
    head = rows[0] if rows else {}
    if (head.get("format") != "borer-records" or head.get("version") != 1
            or head.get("c_bytes") != len(data) or head.get("c_fnv1a64") != f"{fnv1a64(data):016x}"):
        sys.stderr.write("borer: records file does not match the C file, not used\n")
        return {}
    out = {}
    for r in rows[1:]:
        starts = {b["start"]: [int(s, 16) for s in b["starts"]] for b in r.get("blocks", [])}
        lines = [(l["line"], starts.get(l["block"], [])) for l in r.get("lines", [])]
        variables = []
        for v in r.get("variables", []):
            home = v.get("home") or {}
            var = {"name": v["name"], "type": v["type"], "arg_index": v.get("param")}
            kind = "arg" if v.get("param") is not None else HOME_KIND.get(home.get("kind"))
            if kind:
                var["kind"] = kind
            if home.get("kind") == "frame":
                var["stack_offset"] = home["offset"]
            variables.append(var)
        out[int(r["entry"], 16)] = ([(n, a) for n, a in lines if a], variables)
    return out


def parse_export(text):
    out, lines, i = {}, text.splitlines(), 0
    while i < len(lines):
        m = HEADER.match(lines[i])
        if not m:
            i += 1
            continue
        entry, rest = int(m.group(2), 16), m.group(3) or ""
        if rest.startswith("cut, not decompiled"):
            out[entry] = (None, "cut"); i += 1; continue
        if rest.startswith("does not decompile"):
            out[entry] = (None, "failed"); i += 1; continue
        j = i + 1
        if j + 1 < len(lines) and lines[j + 1] == "{" and lines[j] and not lines[j].startswith("//"):
            k = j + 2
            while k < len(lines) and lines[k] != "}":
                k += 1
            if k < len(lines):
                out[entry] = ("\n".join(lines[j:k + 1]) + "\n", "ok"); i = k + 1; continue
        out[entry] = (None, "failed"); i += 1
    return out


def wrap_single(text, name):
    lines = text.splitlines()
    n = 0
    while n < len(lines) and lines[n].startswith("//"):
        n += 1
    head = next((l[len("// signature: "):].strip() for l in lines[:n] if l.startswith("// signature: ")),
                f"void {name}(void)")
    body = lines[n:]
    if not any(l.strip() for l in body):
        return None
    return head + "\n{\n" + "".join(f"  {l}\n" if l else "\n" for l in body) + "}\n"


def best_delta(entries, targets):
    if not entries or not targets:
        return 0
    exact = sum(e in targets for e in entries)
    votes = collections.Counter(t - e for e in sorted(entries)[:300] for t in sorted(targets)[:300])
    best, hits = 0, exact
    for d, _ in votes.most_common(5):
        h = sum(e + d in targets for e in entries)
        if h > hits:
            best, hits = d, h
    return best


SHOWING = re.compile(r"^# showing (\d+) of (\d+) ")
ROW = re.compile(r"^(0x[0-9a-fA-F]+) \d+ \d+ \d+ \d+ \d+ \S+ ")
RANGE = re.compile(r"^range:\s+0x[0-9a-fA-F]+\.\.(0x[0-9a-fA-F]+)", re.M)
PAGE = 300  # the most rows `borer functions` gives at once


def list_functions():
    entries, offset, total = [], 0, None
    while total is None or offset < total:
        p = subprocess.run([borer, "functions", a.binary, "", str(offset), str(PAGE)],
                           capture_output=True, text=True, env=ENV)
        if p.returncode != 0:
            sys.stderr.write(f"borer functions exited {p.returncode}: {p.stderr[-500:]}\n")
            return 1
        lines = p.stdout.splitlines()
        m = next((SHOWING.match(l) for l in lines if SHOWING.match(l)), None)
        if m is None:
            sys.stderr.write(f"borer functions: no '# showing' header in {p.stdout[:300]!r}\n")
            return 1
        total = int(m.group(2))
        page = [int(r.group(1), 16) for r in map(ROW.match, lines) if r]
        if not page:
            break
        entries += page
        offset += len(page)

    def end_of(entry):
        q = subprocess.run([borer, "function", a.binary, f"{entry:#x}"], capture_output=True, text=True, env=ENV)
        r = RANGE.search(q.stdout) if q.returncode == 0 else None
        return int(r.group(1), 16) if r else None

    jobs = int(os.environ.get("BORER_LIST_JOBS") or os.cpu_count() or 1)
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, jobs)) as pool:
        ends = dict(zip(entries, pool.map(end_of, entries)))
    with open(a.out, "w") as out:
        for start in sorted(ends):
            end = ends[start]
            out.write(json.dumps({"start": f"{start:#x}", "end": None if end is None else f"{end:#x}"}) + "\n")
    return 0


ap = argparse.ArgumentParser()
ap.add_argument("--list-functions", action="store_true")
for k in ("binary", "addresses", "elf_base", "out"):
    ap.add_argument("--" + k.replace("_", "-"), required=k != "addresses")
a = ap.parse_args()
borer = os.environ["BORER_BIN"]
if a.list_functions:
    sys.exit(list_functions())
if a.addresses is None:
    ap.error("--addresses is required without --list-functions")
reqs = [l.strip() for l in open(a.addresses) if l.strip()]
with open(a.binary, "rb") as _f:
    _h = _f.read(20)
# 32-bit ARM: bit 0 is the Thumb bit; elsewhere an odd address is an address
arm = _h[:4] == b"\x7fELF" and int.from_bytes(_h[18:20], "little" if _h[5] == 1 else "big") == 40
mask = ~1 if arm else ~0
want = {int(r, 16) & mask: r for r in reqs}
with tempfile.TemporaryDirectory() as td:
    c = os.path.join(td, "out.c")
    p = subprocess.run([borer, "export", a.binary, "--c", c, "--library", "--records"],
                       capture_output=True, text=True, env=ENV)
    parsed = parse_export(open(c, errors="replace").read()) if os.path.exists(c) else {}
    records = read_records(c, os.path.join(td, "out.records.jsonl"))
parsed = {e & mask: v for e, v in parsed.items()}
records = {e & mask: v for e, v in records.items()}
delta = best_delta(list(parsed), set(want))
with open(a.out, "w") as out:
    for va, r in sorted(want.items()):
        code, status = parsed.get(va - delta, (None, "missing"))
        err, mappings, variables = None, [], []
        if status == "ok":
            lines, variables = records.get(va - delta, ([], []))
            mappings = [{"line_number": n, "addresses": [(x & mask) + delta for x in addrs]} for n, addrs in lines]
        if status == "cut":
            q = subprocess.run([borer, "decompile", a.binary, hex(int(r, 16) - delta), "full", "0", "100000000"],
                               capture_output=True, text=True, env=ENV)
            code = wrap_single(q.stdout, f"sub_{va:x}") if q.returncode == 0 else None
        if not code:
            err = f"borer: {status}" + ("" if parsed else f" (export exited {p.returncode}: {p.stderr[-300:]})")
        out.write(json.dumps({"address": r, "code": code, "error": err,
                              "line_mappings": mappings, "variables": variables}) + "\n")
