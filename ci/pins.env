# Every tool version the corpus and the ranking depend on. Changing a pin
# invalidates earlier results.
# Pinned cross image (image-cross.yml run 45435289342, r3): native base + cross GCC 16.2.0 / Clang 23.1.6 for i686, aarch64, armv7
BUILD_IMAGE_CROSS=ghcr.io/fission-systems/freshbench-build-cross@sha256:83f041f7a522f4012b7fe756a22c26000a424791a29ebac9dcf0af3df3ec3407
GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.2_build/ghidra_12.2_PUBLIC_20261016.zip
GHIDRA_SHA256=2c2cd776db3c1f6a097ba418922378ac3649cadd5e844a6f5f088ae628a7be67
GHIDRA_DIR=ghidra_12.2_PUBLIC
# the interpreter the Python adapters run on, and the JVM Ghidra runs on (evaluate.yml)
PYTHON_VERSION=3.12.16
JAVA_VERSION=21.0.13+9
ANGR_VERSION=10.0.7
KUNA_TAG=v1.1003
KUNA_URL=https://github.com/Noelo-Lab/kuna/releases/download/v1.1003/kuna-v1.1003-linux-x86_64.tar.gz
KUNA_SHA256=b30098c91780ecbc7a839e41ca4e2129e26557075741a387925771a25d06ba3d
FISSION_REPO=https://github.com/fission-systems/Fission
FISSION_SHA=24ecf5b2cff1312a4f9ecbb9601b4baac187ab11
BORER_TAG=v0.3.1
BORER_URL=https://github.com/imjustprism/borer/releases/download/v0.3.1/borer-v0.3.1-x86_64-unknown-linux-gnu.tar.gz
BORER_SHA256=d3b7f894edf9703e6e3c128332a62c9acdb49d6e2ce9ceb2e1aab0fec3845d53
# Unlace has no binary releases: built from this commit (cargo build --release -p unlace-cli)
UNLACE_REPO=https://github.com/coleleavitt/unlace
UNLACE_SHA=ed9ebd41f34f50b5b090d2f57f43d049e4b7ef48
# ghidra-rs (koute/ghidra-decompiler, a pure-Rust port of Ghidra 12.2's C++ decompiler):
# the crates.io release pinned in adapters/ghidra-rs/Cargo.toml (=2.1.0) and its Cargo.lock,
# packaged from upstream commit GHIDRA_RS_SHA. Built by evaluate.yml's build job, which checks
# the lock file against these values.
GHIDRA_RS_REPO=https://github.com/koute/ghidra-decompiler
GHIDRA_RS_VERSION=2.1.0
GHIDRA_RS_CRATE_SHA256=a68a5bd2d6e7f477e4e9cd41f3ebcd7d2e43e30775c2fd620c05786f60c60a92
GHIDRA_RS_SHA=268c3a406d8d964bc00ae2ead4d3e1e1373aaa27
# rev.ng has no releases or tags: the content-addressed binary distribution its install.sh
# resolves to, built from revng@REVNG_COMMIT (2026-11-23). Linux x86-64 only. Never `revng update`.
REVNG_COMMIT=1af39407b1826f675ee881faa151a13b3a0a21c9
REVNG_URL=https://revng-website-downloads.s3.fr-par.scw.cloud/binary-archives/public/linux-x86-64/revng-distributable-public-demo/default/none_7361e00740573e8990d13651cedd5314e89e5adc.tar.xz
REVNG_SHA256=f19060db47165388df24343c6c7abc824742ac9063beeb614d474f3c6b764238
# the rev.ng adapter reads rev.ng's YAML model and CFGs
PYYAML_VERSION=6.0.3
# r2sleigh has no releases and no radare2 dependency (r2s is a standalone engine that speaks
# radare2's command language): built from this commit (cargo build --release --locked -p r2s
# --features sleigh; Rust from its rust-toolchain.toml)
R2SLEIGH_REPO=https://github.com/radareorg/r2sleigh
R2SLEIGH_SHA=bd8d52ce4a2de53c2ec61f29f1563e825fe764f6
# Reko: CmdLine zip of release version-0.12.5 (tag commit 418d3538ee87f46e87b80b5b8b93138f63952497),
# framework-dependent net8.0, run with the pinned .NET runtime below
REKO_TAG=version-0.12.5
REKO_URL=https://github.com/uxmal/reko/releases/download/version-0.12.5/CmdLine-0.12.5-x64-418d3538ee.zip
REKO_SHA256=26a0705ed12928d4c0543e2f2c1846fe293220df66ddb41e922afa7c6a4ff9fe
DOTNET_RUNTIME_URL=https://builds.dotnet.microsoft.com/dotnet/Runtime/8.0.34/dotnet-runtime-8.0.34-linux-x64.tar.gz
DOTNET_RUNTIME_SHA512=3949c533b04b0f2b8ed7f6a595409806857891de07eca5ff2795c3ffecc5c373c8977ce296ea1124cef0890f8afeb3365a3bb8514d11a91ba79adb5c47c27ddb
# radare2 release 6.2.6 (tag commit 06a7c9d35468676cc3fe6ea299885cf53aa8ad9b, ABI 174): its amd64
# .deb packages. radare2-dev is needed only to build the r2dec plugin.
RADARE2_TAG=6.2.6
RADARE2_DEB_URL=https://github.com/radareorg/radare2/releases/download/6.2.6/radare2_6.2.6_amd64.deb
RADARE2_DEB_SHA256=0dddf90e217e38a6a658881b9ec7e217198487c75b7f82a332b3cbd30834636f
RADARE2_DEV_DEB_URL=https://github.com/radareorg/radare2/releases/download/6.2.6/radare2-dev_6.2.6_amd64.deb
RADARE2_DEV_DEB_SHA256=343e77919b55ce001a856692ee8e8b9be146d2f7fd82ab2c621779611f9ad4b6
# r2dec release 6.2.0 (tag commit 32ada0dc8bffd1e3ec55d6134531eaae244502ed): the release's source zip
# with its dependencies (QuickJS-ng v0.8.0 vendored), built offline with meson against the radare2
# above. The release's prebuilt linux .so targets radare2 6.2.0 (ABI 132); radare2 6.2.6 refuses it.
R2DEC_TAG=6.2.0
R2DEC_SRC_URL=https://github.com/wargio/r2dec-js/releases/download/6.2.0/r2dec-6.2.0-src-with-deps.zip
R2DEC_SRC_SHA256=3bca1319f3cd4e60050c2bdc62061cae2739e8bc85f654eecb26f4e374837559
# Manifold has no releases or tags: built from this commit with its ascent-plusplus submodule at
# MANIFOLD_ASCENT_SHA. Upstream commits no Cargo.lock: adapters/manifold/Cargo.lock (sha256 below)
# is copied in for --locked. Rust 1.99+ rejects ascent_macro's #![deny(warnings)] (std::usize), so
# the toolchain is pinned. Z3 is the official release zip (libz3.so beside the binary, rpath $ORIGIN).
MANIFOLD_REPO=https://github.com/changliu98/manifold
MANIFOLD_SHA=8c16d4c7f727817ca82344b208898fc469c3aee1
MANIFOLD_ASCENT_SHA=505d1a2c52499643e31ef4ffa7416c5166ae1a7e
MANIFOLD_LOCK_SHA256=c708e737c96b2ac4d26d47aa743de1d4b6cc5c45e4eea8555833f059892d59ca
MANIFOLD_RUST=1.98.0
MANIFOLD_Z3_VERSION=4.16.0
MANIFOLD_Z3_URL=https://github.com/Z3Prover/z3/releases/download/z3-4.16.0/z3-4.16.0-x64-glibc-2.39.zip
MANIFOLD_Z3_SHA256=7288c49a5bd6dbafd7b0b0d1f65956b91672da24b08f09242919af159be3418e
MANIFOLD_Z3_DIR=z3-4.16.0-x64-glibc-2.39
